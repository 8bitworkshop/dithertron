{
  "name": "@8bws/dithertron",
  "version": "1.3.1",
  "description": "Convert images to retro computer graphics formats: palette reduction and dithering with per-system hardware constraints",
  "keywords": [
    "dither",
    "dithering",
    "retro",
    "pixel-art",
    "palette",
    "c64",
    "nes",
    "zx-spectrum",
    "8-bit"
  ],
  "license": "GPL-3.0",
  "author": "Steven Hugg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8bitworkshop/dithertron.git"
  },
  "homepage": "https://8bitworkshop.com/dithertron/",
  "type": "module",
  "main": "./gen/index.js",
  "types": "./gen/index.d.ts",
  "exports": {
    ".": {
      "types": "./gen/index.d.ts",
      "import": "./gen/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "gen",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run esbuild-worker && npm run esbuild-ui",
    "clean": "rm -fr ./gen ./dist",
    "esbuild-worker": "esbuild src/worker/worker.ts --bundle --sourcemap --target=es2017 --outfile=./dist/worker.js",
    "esbuild-ui": "esbuild src/ui/ui.ts --loader:.asm=text --format=esm --bundle --minify --sourcemap --target=es2017 --outfile=./dist/ui.js --external:path --external:fs",
    "build:lib": "node -e \"require('fs').rmSync('gen',{recursive:true,force:true})\" && tsc -p tsconfig.lib.json --emitDeclarationOnly --removeComments false && tsc -p tsconfig.lib.json --declaration false --removeComments true",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm run typecheck && npm run test-unit",
    "typecheck": "tsc --noEmit",
    "test-unit": "tap --disable-coverage --comments --timeout=180 run",
    "test-unit-cov": "tap --allow-incomplete-coverage --comments --timeout=180 run",
    "test-web": "npx nightwatch --config nightwatch.conf.cjs --test test/nightwatch/**.js --headless",
    "test": "npm run test-unit && npm run test-web",
    "release": "node scripts/release.mjs"
  },
  "tap": {
    "files": [
      "test/unit/*.ts"
    ]
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/jquery": "^3.5.0",
    "bootstrap": "^4.6.2",
    "bootstrap-slider": "^11.0.2",
    "cropper": "^4.1.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "file-saver": "^2.0.2",
    "font-awesome": "^4.7.0",
    "jpeg-js": "^0.4.4",
    "jquery": "^3.5.0",
    "localforage": "^1.9.0",
    "nightwatch": "^3.12.3",
    "pica": "^10.0.3",
    "tap": "^21.6.2",
    "typescript": "^5.0.4"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "uuid": ">=11.1.1"
  }
}
