{
  "name": "dithertron",
  "version": "1.3.1",
  "description": "Convert images to retro computer graphics formats: palette reduction and dithering with per-system hardware constraints",
  "keywords": [
    "dither",
    "dithering",
    "retro",
    "pixel-art",
    "palette",
    "c64",
    "nes",
    "zx-spectrum",
    "8-bit"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8bitworkshop/dithertron.git"
  },
  "homepage": "https://8bitworkshop.com/dithertron/",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "tsbuild": "tsc",
    "build": "npm run esbuild-worker && npm run esbuild-ui",
    "clean": "rm -fr ./gen ./dist",
    "esbuild-worker": "esbuild src/worker/worker.ts --bundle --sourcemap --target=es2017 --outfile=./gen/worker.js",
    "esbuild-ui": "esbuild src/ui/ui.ts --loader:.asm=text --format=esm --bundle --minify --sourcemap --target=es2017 --outfile=./gen/ui.js --external:path --external:fs",
    "test-unit": "tap --disable-coverage --comments --timeout=180 run",
    "test-unit-cov": "tap --allow-incomplete-coverage --comments --timeout=180 run",
    "test-web": "npx nightwatch --test test/nightwatch/**.js --headless",
    "test": "npm run test-unit && npm run test-web",
    "build-lib": "npm run build-lib-js && npm run build-lib-types",
    "build-lib-js": "esbuild src/index.ts --bundle --sourcemap --target=es2017 --format=esm --outfile=dist/index.mjs && esbuild src/index.ts --bundle --sourcemap --target=es2017 --format=cjs --outfile=dist/index.cjs",
    "build-lib-types": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run clean && npm run build-lib && npm run test-unit"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/jquery": "^3.5.0",
    "@types/pica": "^9.0.4",
    "bootstrap": "^4.6.2",
    "bootstrap-slider": "^11.0.2",
    "cropper": "^4.1.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "file-saver": "^2.0.2",
    "font-awesome": "^4.7.0",
    "jpeg-js": "^0.4.4",
    "jquery": "^3.5.0",
    "localforage": "^1.9.0",
    "nightwatch": "^3.12.3",
    "pica": "^10.0.3",
    "tap": "^21.6.2",
    "typescript": "^5.0.4"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "uuid": ">=11.1.1"
  }
}
