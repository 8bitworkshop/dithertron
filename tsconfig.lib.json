{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Publish only compiled output: no source/declaration maps that point at
    // src/, and no comments carried over from the TypeScript sources.
    "sourceMap": false,
    "declarationMap": false,
    "declaration": true,
    "removeComments": true
  },
  "exclude": [
    // UI-only modules: not part of the headless library entry.
    "src/ui",
    "src/worker",
    "src/export/fileviewers.ts",
    "src/settings/systeminfo.ts"
  ]
}
